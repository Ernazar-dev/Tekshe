PORT=4000
# Vergul menen bir neshe domen: http://localhost:5173,https://tekshe.onrender.com
CORS_ORIGIN=http://localhost:5173

# Lokal islewde — JSON fayl (kerek emes bolsa DATABASE_URL beriń)
DATA_FILE=./data/db.json

# Postgres (Neon). Berilse JSON fayl isletilmeydi. Production'da SHÁRT.
# Neon -> Connect -> «Pooled connection» -> URL (sslmode=require menen)
DATABASE_URL=

# MÁJBÚRIY. Keminde 16 belgi. Dúziw: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Hár rol ushın 1 akkaunt: login (3–32 belgi: háripler, sanlar, . _ -) hám parol birge (parol keminde 8 belgi).
# Berilmegen rol jaratılmaydı. Production'da tek ADMIN shárt.
ADMIN_LOGIN=
ADMIN_PASSWORD=
MENTOR_LOGIN=
MENTOR_PASSWORD=
STUDENT_LOGIN=
STUDENT_PASSWORD=
EMPLOYER_LOGIN=
EMPLOYER_PASSWORD=
